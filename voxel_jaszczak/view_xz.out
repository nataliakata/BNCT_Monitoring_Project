'no. =  1,  ie =  1,  iy =  1'
msuc: {\huge T-Track in the x-z plane (height is in x)}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.37}

x: z [cm]
y: x [cm]
set: c1[ 0.350] c2[ 1.521] c5[ 0.800] c6[ 0.693] c7[ 0.000] c8[ 0.743]
p: h2fs form[c1] xfac[c2] afac[c5] scal[c6] xorg[c7] yorg[c8] nosp
