$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
$T-VOLUME

[t-volume] %switch3%
     mesh =  reg
      reg =  101 110 400 501 520 522 549 550 201 203 204 206 211 213 215 217 219 228 229 230 231 234 235 238 239 242 243 244 245 246 247 210 
     file =  volume_all.out
   s-type =  2
       x0 = -160.00           # (D=0.0) center position of x-axis [cm]
       x1 =  230.00
       y0 = -367.00           # (D=0.0) center position of y-axis [cm]
       y1 =  200.00           # minimum position of z-axis [cm] 
       z0 = -452.00
       z1 =  454.00

[ T-4Dtrack ] off
    file = 4Dtrack.out $ Output trajectory file name for PHIG-3D 
    HistoryMax = 100 $ Record up to 10 particle histories 
$    SkipRate = 0.01 $ Skip 99% of track points to reduce file size (1% sampled) 
    stepminEM = 0.1 $ Minimum step length (cm) for e-, e+, and photons verbose = 1 $ Level 1: include particle


[ E n d ]
