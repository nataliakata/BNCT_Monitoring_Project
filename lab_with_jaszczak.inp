$DETECTOR SPECTRA

[ T - D e p o s i t ] $detector TR1
    title = Raw Energy Deposition (Smearing in Python)
     mesh =    reg
      reg =    230
     unit =    3
   letmat =    0
  dedxfnc =    1
 material =    all
   output =    deposit
   e-type =    2
     emin =    0.00000
     emax =    2.50000
       ne =    1000
     axis =    eng
     file =    detector_raw_tr1.out
     part =    all
    y-txt =    Counts [1/source]
   epsout =    1
   dresol =    -1.0          # (D=0) ; width = sqrt(dresol**2 + dfano*E); https://www.berkeleynucleonics.com/lanthanum-bromide/ resolution = 3% 

