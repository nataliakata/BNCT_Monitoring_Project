$we are here

set: %qual%[200]
$the switch turns "on" or "off" t-tracks for flux analysis 
set: %switch%[off]
$ GRAPHIC OUTPUT
set: %switch2%[off]
$ GRAPHIC OUTPUT
set: %switch3%[off]
$ GRAPHIC OUTPUT
set: %switch4%[off]

 [ T i t l e ]  

input file for lecture about tally

[ P a r a m e t e r s ]
 icntl    =           8    # (D=0) 3:ECH 5:NOR 6:SRC 7,8:Check geometry 11:DSH 12:DUMP
 maxcas   =           50000   # (D=10) number of particles per one batch 20000 
 maxbch   =           800     # (D=10) number of batches 100 
 itall    =           1     
  negs    =           1
 e-mode   =           2     # 0: sampling mode; 1: adds evaporation;  2: adds also accurate charged particle yields and accurate neutron  energy distribution

  $ istdev = -1 #execute PHITS in restart calculation mode
set: c41[-1.3] c42[ 8.7] c43[-342.] c44[-341.] c45[292.8] c46[302.8] c47[10] c48[10] c49[1] c50[0]
set: c1[-35] c2[-33.0] c3[35.01] c4[19.24] c5[11.2] c6[0.32] c7[c2+c6] c8[c4-2*c6] c9[c5-c6] c10[8.8] c11[c7+c10] c12[0.32] c13[c7+c10+c6] c14[c8-c10-c12] c15[12.7] c16[7.0] c18[c7+c15]  
set: c19[0.01] c20[9.88] c21[c7+c19] c22[c10+c12-0.1] c23[35.0] c24[-20.0] c25[13.0] c26[2.56] c27[2*c26] c28[0.5] c29[c26+c28] c30[c25-c28] c31[c27+2*c28] c33[1.0] c34[-5.8] c35[0.0] 
set: c36[-13.0] c37[2.0] c38[0.09] c39[c21+c38] c40[c22-2*c38] c51[3.] c52[c30-c51] c53[c31+2*c51] c54[c29+c51]
$ c params cant expand beyond the current window
$parameters:
$   manipulating x0, y0, z0 - c1, c2, c3 will move the whole block
$   base_outer: x0, y0, z0 - c1, c2, c3; h (18.6 + 2*0.32 = 18.6 + 0.64 = 19.24) -  c4; 
$   radius_outer: (21.6/2 + 0.32 = 10.8 + 0.32 = 11.12) - c5; thickness: t - c6;
$   ure_nt_rd: d30;
$   base_inner: x0, y0, z0 - c1, c7, c3; h - c8; 
$   rod_secton: x0, y0, z0 - c1, c7, c3; h - c10;
$   inbetween: x0, y0, z0 - c1, c11, c3; h - c12;
$   sphere_sect: x0, y0, z0 - c1, c13, c3; h - c14;
$   sphere_dist_from_inner_base: c15; mother_sphere_radius: c16; mother_h: c18; thickness of walls in spheres/ rods: c38
$ 
$ LaBr3: 
$y - c23, z - c24, x - c25, r - c26, vec(x) - c27; 
$ Al: 
$x - c30, vec(x) - c31 r - c29, thickness - c62;
$ source param:
$ distance: c36 (x), radius c37

$THE PROGRAM STOPS READNG LINES AT COL. 200
[ S o u r c e ]
   s-type =   1               # mono-energetic axial source
       z0 =   35.01           # minimum position of z-axis [cm]
       z1 =   35.01           # maximum position of z-axis [cm]
	   x0 =   -4.12
	   y0 =   30.95
       r0 =   0.           # radius [cm]
       dir =   all           #D:1.0 z-direction of beam [cosine] all
       e0 =   14.0          # energy of beam [MeV/u]
     proj =  neutron            # kind of incident nucleus

