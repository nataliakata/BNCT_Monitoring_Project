set: c100[0.5] c202[0.64]
$fajnie byloby c* uporzdkowac 1/10

[ S u r f a c e ]
  10  rpp   -160. 230. -367. 200. -452. 454.
 102  rcc   c2 -c1 c3 c4 0.00 0.00 c5                                     $base_cylider_outer
 103  rcc   c7 -c1 c3 c8 0.00 0.00 c9                                     $base_cylider_inner 
 255  rcc   c24 c23 c25 0.0 0.0 c27 c26                                   $ detector - lithium
 256  rcc   c24 c23 c30 0.0 0.0 c31 c29                                   $ detector - LaBr3
 262 1  rpp c24-c26 c24+c26 c23-c26 c23+c26 c30 c30+0.5                   $ detector - silicon
 257  PX    c36                                                           $ source
 258  C/X   c18 0.0 c37                                                   $ source cut out
$ voxels
 101  rpp   c7-c100 c7+c100 -c1-c100 -c1+c100 c3-c100 c3+c100
 263 1  rpp c24 c24+c202 c23 c23+c202 c30 c30+0.5                         $ detector - silicon - voxel

[ C e l l ]
$ Main spaces
 100   -1              10                          $void                                                                                                                                                                   $void
 101    3   -0.001205 -10 #203 #201 #230 #231 #232 $air
 201     23 -1.190     -102 #203                   $casing  
 203     0             -103 fill = 10              $filling       
 230     25 -5.06      -255 #232      trcl = 1     $detector - crystal
 231     26 -2.71       255 -256 #232 trcl = 1     $detector covering
 232     0             -262       fill = 20        $silicone container

$ Voxel universes
260      0           -263 lat=1 u=20 
        fill = -4:3 -4:3 0:0

        3 3 3 3 3 3 3 3
        3 3 3 3 3 3 3 3
        3 3 3 3 3 3 3 3
        3 3 3 3 3 3 3 3
        3 3 3 3 3 3 3 3
        3 3 3 3 3 3 3 3
        3 3 3 3 3 3 3 3
        3 3 3 3 3 3 3 3

 301     0           -101 lat=1 u=10
     fill = 0:19 -11:11 -11:11
     infl:{lattice_3d.txt}

$ Material universe
 261     27  -2.33       -10 u=3              $ Silicon voxel (Universe 1)
 302     22 -1.00        -10 u=1              $ Standard voxel (Universe 2)
 303     24 -1.00        -10 u=2              $ Boron-doped voxel (Universe 3)

[ T r a n s f o r m ]
*tr1  0.0 0.0 0.0  c2 -c1 c3  0 0.0 0 0.0 0 0.0 3


[ V o l u m e ]
    reg      vol      
    201   3.5525E+02
    203   2.9083E+03
    230   7.4608E+01
    231   1.0550E+02

[ Light ] 
$to avoid the particle weights error in any t-deposits this should actually be equal to 1
$ although, i dont think this matters much
yield-factor = 0.005
transport = 1


set-region
  reg = 232 261             $ silicon
  n = 6.0
  absorption-length = 1.0E-5

set-region
  reg = 231             $ aluminum
  n = 1.0 
  absorption-length = 1.0E-5

set-region
  reg = 230             $ crystal
  n = 2.285
  absorption-length = 13.0
  decay-time = 25.0
  light-yield = 63000
  table-scintillation-spectrum $AI generated basically, but based 
    unit1 = nm 
    351 0.0
    370 0.8
    380 1.0
    410 0.4
    450 0.0
  end-table

set-region 
  reg = 101            $ air
  n = 1.0 
  absorption-length = 1.0E+5

set-boundary           $ crystal -- air (not really necessary)
  reg-from = 230 
  reg-to   = 101
  fraction-absorption = 0.05
  fraction-diffuse = 1.0

set-boundary           $crystal -- aluminum (an absorption rate to get rid of trapped photons)
  reg1 = 230
  reg2 = 231
  fraction-absorption = 0.02
  boundary-type = fresnel
    
set-boundary           $crystal -- SiMP (an absorption rate to get rid of trapped photons)
  reg1 = 230
  reg2 = 232 261
  fraction-absorption = 0.02
  boundary-type = fresnel


$FLUENCE TRACKING
[t-track] 
   title = T-Track in the y-z plane (height is in x)
   mesh = xyz
   x-type =    2            # x-mesh is linear given bx xmin, xmax and nx
     xmin =  c24-2.00      # minimum value of x-mesh points
     xmax =  c24+2.00     # maximum value of x-mesh points
       nx =   1            # number of x-mesh points
   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin =  -c1-30      # minimum value of y-mesh points
     ymax =  -c1+30      # maximum value of y-mes    h points
       ny =   %qual%            # number of y-mes       h points
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =  c3-30     # minimum value of z-mesh points
     zmax =  c3+30     # maximum value of z-mesh points
       nz =   %qual%            # number of z-mesh points
     axis =   yz            # axis of output
     file = view_yz.out    # file name of output for the above axis
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
             0.0  1000.0
     part = neutron light photon
     unit =    1            # unit is [1/cm^2/source]
    gshow =    1
    gslat =    1
   epsout =    1


[t-track] 
    title = T-Track in the y-x plane (height is in x)
   mesh = xyz
   x-type =    2            # x-mesh is linear given bx xmin, xmax and nx
     xmin =  c2-1.0      # minimum value of x-mesh points
     xmax =  c2+20.00     # maximum value of x-mesh points
       nx =   %qual%            # number of x-mesh points
   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin =  -c1-24.0      # minimum value of y-mesh points
     ymax =  -c1+24.0      # maximum value of y-mesh points
       ny =   %qual%            # number of y-mesh points
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =  c3     # minimum value of z-mesh points
     zmax =  c3+.2     # maximum value of z-mesh points
       nz =   1            # number of z-mesh points
     axis =   xy             # axis of output
     file = view_yx.out    # file name of output for the above axis
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
             0.0  1000.0
     unit =    1            # unit is [1/cm^2/source]
    gshow =    1            $ 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
    gslat =    1
   epsout =    1
     part = neutron light photon


[t-track] 
    title = T-Track in the y-x plane (height is in x)
   mesh = xyz
   x-type =    2            # x-mesh is linear given bx xmin, xmax and nx
     xmin =  c24-4      # minimum value of x-mesh points
     xmax =  c24+4     # maximum value of x-mesh points
       nx =   %qual%            # number of x-mesh points
   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin =  c23-4      # minimum value of y-mesh points
     ymax =  c23+4      # maximum value of y-mesh points
       ny =   %qual%            # number of y-mesh points
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =  c30     # minimum value of z-mesh points
     zmax =  c30+0.5     # maximum value of z-mesh points
       nz =   1            # number of z-mesh points
     axis =   xy             # axis of output
     file = view_SiPM.out    # file name of output for the above axis
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
             0.0  1000.0
     unit =    1            # unit is [1/cm^2/source]
    gshow =    1            $ 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
    gslat =    1
   epsout =    1
     part = neutron light photon


[t-track] %switch%
    title = T-Track in the x-z plane (height is in x)
   mesh = xyz
   x-type =    2            # x-mesh is linear given bx xmin, xmax and nx
     xmin =  c2-1.0      # minimum value of x-mesh points
     xmax =  c2+20.00     # maximum value of x-mesh points
       nx =   %qual%            # number of x-mesh points
   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin =  -c1-12.0      # minimum value of y-mesh points
     ymax =  -c1+12.0      # maximum value of y-mesh points
       ny =   1            # number of y-mes       h points
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =  c3-30     # minimum value of z-mesh points
     zmax =  c3+30     # maximum value of z-mesh points
       nz =   %qual%            # number of z-mesh points
     axis =   xz            # axis of output
     file = view_xz.out    # file name of output for the above axis
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
             0.0  1000.0
     part = neutron light photon
     unit =    1            # unit is [1/cm^2/source]
    gshow =    1
    gslat =    1
   epsout =    1


$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
$DETECTOR SPECTRA
$its been suggested that output = dose ignores particle weights, which could be maybe usefull
[ T - D e p o s i t ] $detector TR1
    title = Raw Energy Deposition (Smearing in Python)
     mesh =    reg
      reg =    230
     unit =    3
   letmat =    0
  dedxfnc =    1
 material =    all
   output =    deposit
   e-type =    2
     emin =    0.00000
     emax =    2.50000
       ne =    1000
     axis =    eng
     file =    detector_raw_tr1.out
     part =    all
    y-txt =    Counts [1/source]
   epsout =    1
   dresol =    -1.0          # (D=0) ; width = sqrt(dresol**2 + dfano*E); https://www.berkeleynucleonics.com/lanthanum-bromide/ resolution = 3% 


